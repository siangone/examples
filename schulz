            <p id="toast-msg" class="text-xs text-slate-300">Vielen Dank. Wir melden uns in Kürze bei Ihnen.</p>
        </div>
    </div>
</div>

<!-- Interactive Logic Scripts -->
<script>
    // Year Script
    document.getElementById('year').innerText = new Date().getFullYear();

    // Mobile Menu Toggle
    function toggleMobileMenu() {
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('hidden');
    }

    // Modal Handlers
    function openCalculatorModal() {
        document.getElementById('calc-modal').classList.remove('hidden');
    }
    function closeCalculatorModal() {
        document.getElementById('calc-modal').classList.add('hidden');
    }
    function openCalculatorWithTab(serviceName) {
        document.getElementById('modal-service-name').value = serviceName;
        openCalculatorModal();
    }

    function openLegalModal(type) {
        document.getElementById('legal-modal').classList.remove('hidden');
        if (type === 'impressum') {
            document.getElementById('legal-content-impressum').classList.remove('hidden');
            document.getElementById('legal-content-datenschutz').classList.add('hidden');
        } else {
            document.getElementById('legal-content-impressum').classList.add('hidden');
            document.getElementById('legal-content-datenschutz').classList.remove('hidden');
        }
    }
    function closeLegalModal() {
        document.getElementById('legal-modal').classList.add('hidden');
    }

    // Calculator Multi-Step Logic
    let currentStep = 1;

    function updateCalcStepUI() {
        // Hide all steps
        for (let i = 1; i <= 4; i++) {
            document.getElementById(`calc-step-${i}`).classList.add('hidden');
        }
        document.getElementById(`calc-step-${currentStep}`).classList.remove('hidden');

        // Update step badges
        const badges = document.querySelectorAll('.calc-step-badge');
        badges.forEach((b, idx) => {
            if (idx + 1 <= currentStep) {
                b.classList.add('bg-roof-600', 'text-white');
                b.classList.remove('bg-slate-800', 'text-slate-400');
            } else {
                b.classList.remove('bg-roof-600', 'text-white');
                b.classList.add('bg-slate-800', 'text-slate-400');
            }
        });

        // Update step progress line
        const line = document.getElementById('step-line');
        line.style.width = (currentStep * 25) + '%';

        // Prev Button Visibility
        const prevBtn = document.getElementById('calc-prev-btn');
        if (currentStep > 1) {
            prevBtn.classList.remove('hidden');
        } else {
            prevBtn.classList.add('hidden');
        }

        // Next Button Text
        const nextBtn = document.getElementById('calc-next-btn');
        if (currentStep === 4) {
            nextBtn.classList.add('hidden');
        } else {
            nextBtn.classList.remove('hidden');
            nextBtn.innerHTML = 'Weiter <i class="fa-solid fa-arrow-right ml-2"></i>';
        }
    }

    function nextCalcStep() {
        if (currentStep < 4) {
            currentStep++;
            updateCalcStepUI();
        }
    }

    function prevCalcStep() {
        if (currentStep > 1) {
            currentStep--;
            updateCalcStepUI();
        }
    }

    function updateCalcEstimate() {
        const area = parseInt(document.getElementById('area-slider').value);
        let basePricePerM2 = 90; // base price €/m²

        const selectedRoof = document.querySelector('input[name="roof_type"]:checked')?.value;
        if (selectedRoof === 'Flachdach') basePricePerM2 = 80;
        if (selectedRoof === 'Walmdach') basePricePerM2 = 110;

        let extra = 0;
        if (document.getElementById('opt-daemmung').checked) extra += 45;
        if (document.getElementById('opt-rinnen').checked) extra += 15;
        if (document.getElementById('opt-fenster').checked) extra += 25;
        if (document.getElementById('opt-solar').checked) extra += 10;

        const totalPerM2 = basePricePerM2 + extra;
        const lowEst = Math.round(area * totalPerM2 * 0.9 / 100) * 100;
        const highEst = Math.round(area * totalPerM2 * 1.15 / 100) * 100;

        document.getElementById('estimate-result').innerText = `ca. ${lowEst.toLocaleString('de-DE')} € - ${highEst.toLocaleString('de-DE')} €`;
    }

    // Toast Notification System
    function showToast(title, msg) {
        const toast = document.getElementById('toast');
        document.getElementById('toast-title').innerText = title;
        document.getElementById('toast-msg').innerText = msg;

        toast.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
            toast.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
            toast.classList.remove('translate-y-0', 'opacity-100');
        }, 4000);
    }

    // Form Submissions
    function handleHeroSubmit(e) {
        e.preventDefault();
        showToast('Rückrufanfrage erhalten!', 'Herr Schulz oder das Team rufen Sie in Kürze zurück.');
        e.target.reset();
    }

    function handleMainContactSubmit(e) {
        e.preventDefault();
        showToast('Anfrage Gesendet!', 'Vielen Dank für Ihre Anfrage. Wir erstellen Ihr Angebot umgehend.');
        e.target.reset();
    }

    function submitCalculatorLead() {
        const name = document.getElementById('calc-name').value;
        const phone = document.getElementById('calc-phone').value;
        if (!name || !phone) {
            alert('Bitte füllen Sie Name und Telefonnummer aus.');
            return;
        }
        showToast('Kalkulation Gesendet!', 'Wir prüfen Ihre Dachdaten und kontaktieren Sie.');
        currentStep = 1;
        updateCalcStepUI();
        document.getElementById('calc-form').reset();
    }

    function handleModalQuickSubmit(e) {
        e.preventDefault();
        closeCalculatorModal();
        showToast('Angebot Angefordert!', 'Wir verarbeiten Ihre Daten und melden uns schnellstmöglich.');
    }

    // Gallery Filter
    function filterGallery(category) {
        const btns = document.querySelectorAll('.gallery-btn');
        btns.forEach(b => {
            b.classList.remove('bg-roof-600', 'text-white');
            b.classList.add('bg-slate-800', 'text-slate-300');
        });
        event.currentTarget.classList.add('bg-roof-600', 'text-white');
        event.currentTarget.classList.remove('bg-slate-800', 'text-slate-300');

        const items = document.querySelectorAll('.gallery-item');
        items.forEach(item => {
            if (category === 'all' || item.classList.contains(category)) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }
</script>
</body>
</html>
